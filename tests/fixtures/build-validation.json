                "version": 1,
                "size": { "w": 4, "h": 3, "d": 4 },
                "palette": ["01aaaaaaaaaaaaaaaaaaaaaaaa"],
                "blocks": [[0, 0, 0, 0, 0, -1]]
            },
            "expect": [{ "code": "step_out_of_range", "index": 0 }]
        },
        {
            "name": "step 2 with two steps",
            "steps": 2,
            "data": {
                "version": 1,
                "size": { "w": 4, "h": 3, "d": 4 },
                "palette": ["01aaaaaaaaaaaaaaaaaaaaaaaa"],
                "blocks": [[0, 0, 0, 0, 0, 2]]
            },
            "expect": [{ "code": "step_out_of_range", "index": 0 }]
        },
        {
            "name": "two blocks in one cell",
            "steps": 1,
            "data": {
                "version": 1,
                "size": { "w": 4, "h": 3, "d": 4 },
